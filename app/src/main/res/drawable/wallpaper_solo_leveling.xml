<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: deep black -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#050810"/>
        </shape>
    </item>
    <!-- Gradient: dark navy to deep purple -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#0A1543"
                android:centerColor="#0D0D2B"
                android:endColor="#1A0A2E"/>
        </shape>
    </item>
    <!-- Bottom glow: electric blue -->
    <item android:top="1600dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="0.5"
                android:centerY="0.0"
                android:startColor="#201B45D7"
                android:endColor="#00000000"/>
        </shape>
    </item>
    <!-- Center glow: purple aura -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:centerX="0.5"
                android:centerY="0.3"
                android:startColor="#157C3AED"
                android:endColor="#00000000"/>
        </shape>
    </item>
    <!-- Top glow: subtle blue -->
    <item android:bottom="1200dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="0.3"
                android:centerY="0.5"
                android:startColor="#0C3B6EFF"
                android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>
